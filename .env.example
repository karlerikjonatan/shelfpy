# Copy to .env and adjust as needed, then run:
#   node --env-file=.env src/index.js
# (or `npm run start:env`, or just export these in your shell before `npm start`)
# Requires Node >= 20.6. All three are optional — sensible defaults apply.

# 2-letter Sellpy locale to search, matching the site's own per-country
# config keys (sv=Sweden, en=international/English, de=Germany, fr=France, ...)
SELLPY_LOCALE=sv

# Path to a JSON array of search terms (e.g. author names) to look up.
# AUTHORS_PATH=./authors.json

# Where to write the resulting CSV.
# OUT_PATH=./books.csv
